# Copy to .env for local use. On AWS set these as ECS task environment variables instead.
# With nothing set, the backend runs locally on files, with no login and no model.

# ----- AWS storage: set ALL of these to switch every store to S3 and DynamoDB ---------------
AWS_REGION=eu-north-1
# S3_BUCKET=
# DDB_REGISTRY=
# DDB_KG=
# DDB_HISTORY=
# DDB_JOBS=
# DDB_AUDIT=
# RECORD_TTL_DAYS=30
# AUDIT_LOG_TTL_DAYS=365

# ----- Sign-in (Microsoft Entra ID). Leave empty for local development. ---------------------
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_REQUIRED_SCOPE=access_as_user
# ROLE_USER=AI4BI.User
# ROLE_STEWARD=AI4BI.Steward
# Restrict domains to Entra groups: {"finance": ["<group object id>"]}
# DOMAIN_GROUPS=
# Only for a private demo: allow AWS storage without sign-in.
# ALLOW_ANON=0

# ----- Model (Amazon Bedrock). Leave BEDROCK_DEFAULT_MODEL empty to use no model. -----------
# BEDROCK_REGION=
# BEDROCK_DEFAULT_MODEL=
# BEDROCK_STRONG_MODEL=
# BEDROCK_CHEAP_MODEL=
# One call can be pinned to its own model: MODEL_AI4BI_SQL=<model id>
# Bedrock Prompt Management overrides for prompts/*.txt: {"ai4bi_sql": "<prompt id>"}
# BEDROCK_PROMPT_IDS=
# LLM_MODE=bedrock
# LLM_MAX_TOKENS=6000
# LLM_TEMPERATURE=0

# ----- Behaviour -------------------------------------------------------------------------------
# DEFAULT_DOMAIN=service_ops
# ROW_LIMIT=500
# PREVIEW_ROWS=20
# PERSIST_EPISODES=1
# INCLUDE_DRAFTS=0
# JOIN_MIN_OVERLAP=0.8
# ACTIVATION_CONFIDENCE=0.75
# JOB_WORKERS=2
# UPLOAD_MAX_BYTES=104857600
# PRESIGN_EXPIRY_SECONDS=900
# DATA_CACHE_SECONDS=60
# DATA_CACHE_MAX_ENTRIES=8

# ----- Web and logging ---------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# CORS_ALLOW_LOCALHOST=1
# LOG_LEVEL=INFO
# LOG_JSON=1
