# Copy to .env for local development. Nothing in the AWS section is required locally: with no
# DDB_* settings the backend stores sessions as files under backend/data/.

# --- LLM (OpenRouter) ---------------------------------------------------------------------
# OPENROUTER_API_KEY=
# DEEPL_API_KEY=

# --- AWS storage: set DDB_DOCS to use DynamoDB instead of local files ---------------------------
# There is no S3: each session's DataFrames stay in this process's memory, so run ONE backend
# task (or turn on ALB stickiness). A restart makes affected sessions answer HTTP 410 until the
# file is uploaded again.
# AWS_REGION=eu-north-1
# DDB_DOCS=uda327-records-dev
# DDB_PROFILES=uda327-profiles-dev
# DDB_AUDIT=uda327-events-dev
# MEMORY_FRAME_SESSIONS=50
# SESSION_TTL_DAYS=30
# AUDIT_LOG_TTL_DAYS=365
# UPLOAD_MAX_BYTES=209715200
