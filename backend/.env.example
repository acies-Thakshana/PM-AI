# Copy to .env for local development. With no DDB_* / ENTRA_* settings the backend stores
# sessions as files under backend/data/ and runs with no login.
# LLM calls always go to Amazon Bedrock: run `aws configure` / set AWS_PROFILE and make sure
# your AWS user may call bedrock:InvokeModel.

# --- AWS --------------------------------------------------------------------------------
AWS_REGION=eu-north-1
# BEDROCK_REGION=eu-north-1
# TRANSLATE_REGION=eu-north-1

# --- Storage: set DDB_DOCS to use DynamoDB instead of local files (no S3: DataFrames stay in
# memory, so run ONE task; a restart makes affected sessions answer HTTP 410) ---------------
# DDB_DOCS=uda327-records-dev
# DDB_PROFILES=uda327-profiles-dev
# DDB_AUDIT=uda327-events-dev
# MEMORY_FRAME_SESSIONS=50
# SESSION_TTL_DAYS=30
# UPLOAD_MAX_BYTES=209715200

# --- Microsoft Entra ID: set BOTH to require a signed-in user (the API app's ids) ------------
# ENTRA_TENANT_ID=<directory (tenant) id>
# ENTRA_CLIENT_ID=<application (client) id of the API app registration>
# ENTRA_REQUIRED_SCOPE=access_as_user
# With DDB_DOCS set and no Entra ids the API refuses requests (503) unless ALLOW_ANON=1.
# ALLOW_ANON=1

# --- CORS: comma-separated browser origins allowed to call the API ---------------------------
# CORS_ORIGINS=https://<your-frontend-origin>
# CORS_ALLOW_LOCALHOST=0

# --- Bedrock models (ids or "eu." inference-profile ids your account can call) -------------
# BEDROCK_CHEAP_MODEL=openai.gpt-oss-20b-1:0
# BEDROCK_DEFAULT_MODEL=openai.gpt-oss-20b-1:0
# BEDROCK_STRONG_MODEL=openai.gpt-oss-20b-1:0
# One call only:  MODEL_<CALL_NAME_IN_CAPITALS>=<model id>
# LLM_MAX_TOKENS=6000

# Report translation uses Amazon Translate in TRANSLATE_REGION (the task role needs translate:TranslateText).
