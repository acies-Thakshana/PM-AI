{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-north-1:<ACCOUNT_ID>:table/uda327-*-dev",
        "arn:aws:dynamodb:eu-north-1:<ACCOUNT_ID>:table/uda327-*-dev/index/*"
      ]
    }
  ]
}
