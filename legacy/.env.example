# Copy to .env. Every value is optional; config/settings.yaml supplies defaults.

# Domain package under storage/semantic/domains/<AIBI_DOMAIN>
AIBI_DOMAIN=service_ops

# local = structured fallback, no model call (works offline)
# mesh  = Dataiku LLM Mesh (only inside Dataiku)
AIBI_LLM_MODE=local
AIBI_LLM_CONNECTION=

# Alternate settings file or project root
# AIBI_SETTINGS_PATH=config/settings.local.yaml
# AIBI_PROJECT_ROOT=C:/path/to/AWS_script

AIBI_LOG_LEVEL=INFO

# Dynamic semantic onboarding
AIBI_AUTO_ONBOARD=true
AIBI_INCLUDE_DRAFTS=false
AIBI_JOIN_MIN_OVERLAP=0.8
AIBI_ACTIVATION_CONFIDENCE=0.75
AIBI_ONBOARDING_SAMPLE_VALUES=10
