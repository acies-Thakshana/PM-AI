      "question": "Which sites have the highest productivity?",
      "intent": "ranking",
      "interpreted_question": "Actual Productivity by Site Name",
      "metrics": [
        {
          "name": "Actual Productivity",
          "calculation": "SUM(Actual Productivity)",
          "sql_expression": "SUM(\"Actual Productivity\")",
          "grain": "as stored"
        }
      ],
      "calculations": [
        {
          "name": "sum_actual_productivity",
          "formula": "SUM(\"Actual Productivity\")",
          "rationale": "measure Actual Productivity matched the question"
        }
      ],
      "new_terms": [],
      "sql": "SELECT \"Site Name\" AS \"Site Name\", SUM(\"Actual Productivity\") AS sum_actual_productivity FROM KPI_data WHERE \"Site Name\" IS NOT NULL AND TRIM(\"Site Name\") <> '' GROUP BY \"Site Name\" HAVING SUM(\"Actual Productivity\") IS NOT NULL ORDER BY sum_actual_productivity DESC LIMIT 5",
      "datasets": [
        "KPI_data"
      ],
      "status": "success",
      "answer_excerpt": "Actual Productivity by Site Name: Poland Operations: 235; Franklin: 140; Shanghai Plant: 130; ALC, Kennesaw, GA: 75.30; Pune Works: 25."
    },
    {
