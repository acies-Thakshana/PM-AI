      "label": "SELECT \"Site Name\" AS \"Site Name\", SUM(\"Actual Productivity\") AS sum_actual_productivity FROM KPI_data WHERE \"Site Name\" IS NOT NULL AND TRIM(\"Site Name\") <> '' GROUP BY \"Site Name\" HAVING SUM(\"Actual Productivity\") IS NOT NULL ORDER BY sum",
      "props": {
        "full_sql": "SELECT \"Site Name\" AS \"Site Name\", SUM(\"Actual Productivity\") AS sum_actual_productivity FROM KPI_data WHERE \"Site Name\" IS NOT NULL AND TRIM(\"Site Name\") <> '' GROUP BY \"Site Name\" HAVING SUM(\"Actual Productivity\") IS NOT NULL ORDER BY sum_actual_productivity DESC LIMIT 5",
        "status": "success"
      },
      "updated_at": "2026-10-17T12:58:15.826314+00:00"
    },
