    {
      "id": "sql.validated.vsql_ops_frt_emea",
      "kind": "sql_pattern",
      "label": "What is EMEA FRT?",
      "props": {
        "full_sql": "SELECT AVG((julianday(first_response_at) - julianday(opened_at)) * 24.0) AS first_response_time_emea FROM cases WHERE region = 'EMEA'",
        "status": "validated",
        "source": "validated_sql"
      },
      "updated_at": "2026-10-15T12:33:52.043103+00:00"
    },
    {
      "id": "sql.validated.vsql_ops_frt_by_region",
      "kind": "sql_pattern",
      "label": "What is FRT by region?",
      "props": {
        "full_sql": "SELECT region, AVG((julianday(first_response_at) - julianday(opened_at)) * 24.0) AS first_response_time FROM cases GROUP BY region ORDER BY first_response_time DESC",
        "status": "validated",
        "source": "validated_sql"
      },
      "updated_at": "2026-10-15T12:33:52.043120+00:00"
    },
