    {
      "id": "rule.rule.ops.frt_unit",
      "kind": "business_rule",
      "label": "First Response Time is reported in hours, from opened_at to first_response_at.",
      "props": {
        "rule_type": "definition",
        "applies_to": [
          "metric.service_ops.frt_global",
          "metric.service_ops.frt_emea",
          "metric.service_ops.frt_apac"
        ],
