    {
      "id": "metric.frt",
      "kind": "metric",
      "label": "First Response Time",
      "props": {
        "family": "frt",
        "definition": "Hours from case open to first agent response. Regional variants exist because operating hours differ. Global, EMEA, and APAC are sibling metrics in the catalog - not prompt forks.\n",
        "formula_hint": "AVG hours between opened_at and first_response_at",
        "grain": "one row per service_case",
        "scopes": [
          "global",
          "emea",
          "apac"
        ],
        "source": "dictionary"
      },
      "updated_at": "2026-10-15T12:33:52.042822+00:00"
    },
    {
      "id": "term.frt",
      "kind": "glossary",
      "label": "FRT",
      "props": {
        "maps_to": "frt",
        "term_kind": "acronym",
        "source": "glossary"
      },
      "updated_at": "2026-10-15T12:33:52.042960+00:00"
    },
    {
      "id": "term.first_response",
      "kind": "glossary",
      "label": "first response",
      "props": {
        "maps_to": "frt",
        "term_kind": "synonym",
        "source": "dictionary"
      },
      "updated_at": "2026-10-15T12:33:52.042862+00:00"
    },
    {
      "id": "term.time_to_first_response",
      "kind": "glossary",
      "label": "time to first response",
      "props": {
        "maps_to": "frt",
        "term_kind": "business_phrase",
        "source": "glossary"
      },
      "updated_at": "2026-10-15T12:33:52.042988+00:00"
    },
    {
      "id": "metric.service_ops.frt_global",
      "kind": "metric",
      "label": "First Response Time (global)",
      "props": {
        "family": "frt",
        "scope": "global",
        "version": "1.0.0",
        "status": "certified",
        "sql_expression": "AVG(TIMESTAMPDIFF(HOUR, opened_at, first_response_at))",
        "grain": "one row per service_case",
        "source": "catalog"
      },
      "updated_at": "2026-10-15T12:33:52.042894+00:00"
    },
    {
      "id": "metric.service_ops.frt_emea",
      "kind": "metric",
      "label": "First Response Time (emea)",
      "props": {
        "family": "frt",
        "scope": "emea",
        "version": "1.0.0",
        "status": "certified",
        "sql_expression": "AVG((julianday(first_response_at) - julianday(opened_at)) * 24.0)",
        "filter_sql": "region = 'EMEA'",
        "grain": "one row per service_case",
        "source": "catalog",
        "calculation": "AVG(TIMESTAMPDIFF(HOUR, opened_at, first_response_at))",
        "last_question": "What is EMEA FRT?"
      },
