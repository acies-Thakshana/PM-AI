    {
      "id": "doc.service_handbook.1",
      "kind": "document_fact",
      "label": "First Response Time (FRT) measures how quickly an agent replies to a new case. The clock starts when the case is opened and stops at the first agent response. Weekends are not excluded in the current definition.",
      "props": {
        "text": "First Response Time (FRT) measures how quickly an agent replies to a new case. The clock starts when the case is opened and stops at the first agent response. Weekends are not excluded in the current definition.",
        "heading": "First Response Time",
        "source": "service_handbook.md"
      },
      "updated_at": "2026-10-15T12:33:52.044710+00:00"
    },
    {
      "id": "doc.service_handbook.2",
      "kind": "document_fact",
      "label": "Regional FRT targets differ because operating hours differ: EMEA targets 4 hours, APAC targets 8 hours, and AMER targets 4 hours.",
      "props": {
        "text": "Regional FRT targets differ because operating hours differ: EMEA targets 4 hours, APAC targets 8 hours, and AMER targets 4 hours.",
        "heading": "First Response Time",
        "source": "service_handbook.md"
      },
      "updated_at": "2026-10-15T12:33:52.044735+00:00"
    },
    {
      "id": "doc.service_handbook.3",
      "kind": "document_fact",
      "label": "A case is open until an agent marks it closed. The case_extension custom object stores a severity value of high, medium, or low for each case.",
      "props": {
        "text": "A case is open until an agent marks it closed. The case_extension custom object stores a severity value of high, medium, or low for each case.",
        "heading": "Case lifecycle",
        "source": "service_handbook.md"
      },
      "updated_at": "2026-10-15T12:33:52.044754+00:00"
    },
    {
      "id": "doc.service_handbook.4",
      "kind": "document_fact",
      "label": "Customer contact email addresses are collected for service delivery only. Analytics and AI answers must never expose or filter on them.",
      "props": {
        "text": "Customer contact email addresses are collected for service delivery only. Analytics and AI answers must never expose or filter on them.",
        "heading": "Data handling",
